# Copy to .env (gitignored) and fill in your own values.
# Load before deploying:  set -a; source .env; set +a

# Invoice section that pays for newly created subscriptions (only needed when creating).
#   az billing profile list --account-name <billing-account> --expand invoiceSections
AZ_BILLING_SCOPE='/providers/Microsoft.Billing/billingAccounts/<billing-account-id>/billingProfiles/<billing-profile-id>/invoiceSections/<invoice-section-id>'

# Existing subscription to move under <prefix>-corp. Leave empty to create a new one.
AZ_WORKLOAD_SUBSCRIPTION_ID='<subscription-id>'
